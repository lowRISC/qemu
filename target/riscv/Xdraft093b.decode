# Fields:
%rs3       27:5
%rs2       20:5
%rs1       15:5
%rd        7:5
%sh5       20:5

# Argument sets:
&r         rd rs1 rs2                               !extern
&shift     shamt rs1 rd                             !extern
&r4        rd rs1 rs2 rs3
&r4_sh     rd rs1 shamt rs3

# Formats:
@r         .......  ..... .....   ... ..... ....... &r                %rs2 %rs1 %rd
@sh5       .......  ..... .....   ... ..... ....... &shift  shamt=%sh5     %rs1 %rd
@r4        ..... .. ..... .....   ... ..... ....... &r4               %rs3 %rs2 %rs1 %rd
@r4_sh     ..... .. ..... .....   ... ..... ....... &r4_sh  shamt=%sh5 %rs3     %rs1 %rd

# *** RV32 Xdraft093b Extension (Bitmanip draft 0.93) ***
grevi      0110100  ..... .....   101 ..... 0010011 @sh5
gorci      0010100  ..... .....   101 ..... 0010011 @sh5
unshfli    0000100  ..... .....   101 ..... 0010011 @sh5
shfli      0000100  ..... .....   001 ..... 0010011 @sh5
